		{
			"name": "Users",
			"item": [
				{
					"name": "Create a new user - Success (201)",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test(\"Status code is 201 Created\", function () {",
									"    pm.response.to.have.status(201);",
									"});",
									"",
									"pm.test(\"Response body contains user details\", function () {",
									"    const responseJson = pm.response.json();",
									"    pm.expect(responseJson).to.have.property('id');",
									"    pm.expect(responseJson).to.have.property('email', 'testuser@example.com');",
									"    pm.expect(responseJson).to.have.property('firstName', 'Test');",
									"    pm.expect(responseJson).to.have.property('lastName', 'User');",
									"    pm.expect(responseJson).to.have.property('birthdayDate', '1990-05-15');",
									"    pm.expect(responseJson).to.have.property('anniversaryDate', '2020-01-01');",
									"    pm.expect(responseJson).to.have.property('location', 'Asia/Jakarta');",
									"});",
									"",
									"// Store the created user ID and email for subsequent tests",
									"const responseJson = pm.response.json();",
									"pm.environment.set(\"created_user_id\", responseJson.id);",
									"pm.environment.set(\"created_user_email\", responseJson.email);"
								],
								"type": "text/javascript",
								"packages": {}
							}
						}
					],
					"request": {
						"auth": {
							"type": "noauth"
						},
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json",
								"type": "default"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"email\": \"testuser@example.com\",\n  \"first_name\": \"Test\",\n  \"middle_name\": \"\",\n  \"last_name\": \"User\",\n  \"birthday_date\": \"1990-05-15\",\n  \"anniversary_date\": \"2020-01-01\",\n  \"location\": \"Asia/Jakarta\"\n}",
							"options": {
								"raw": {
