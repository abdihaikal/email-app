  },
  "tags": [],
  "servers": [],
  "components": {
    "schemas": {
      "CreateUserDto": {
        "type": "object",
        "properties": {
          "birthday_date": {
            "type": "string",
            "description": "User birthday in YYYY-MM-DD format",
            "example": "1980-01-01"
          },
          "anniversary_date": {
            "type": "string",
            "description": "User anniversary in YYYY-MM-DD format",
            "example": "2025-01-01"
          },
          "email": {
            "type": "string",
            "description": "User email address",
            "example": "abdihaikal@email.com"
          },
          "first_name": {
            "type": "string",
            "description": "User first name",
            "example": "Abdi",
            "minLength": 3,
            "maxLength": 50
          },
          "middle_name": {
            "type": "string",
            "description": "User middle name",
            "example": "",
            "minLength": 3,
            "maxLength": 50
          },
          "last_name": {
            "type": "string",
            "description": "User last name",
            "example": "Haikal",
            "minLength": 3,
            "maxLength": 50
          },
          "location": {
            "type": "string",
            "description": "User timezone (IANA Time Zone Database identifier)",
            "example": "Asia/Jakarta",
            "minLength": 5,
            "maxLength": 100,
            "default": "Asia/Jakarta"
          }
        },
        "required": [
          "email",
          "first_name",
          "last_name"
        ]
      },
      "UpdateUserDto": {
        "type": "object",
        "properties": {
          "birthday_date": {
            "type": "string",
            "description": "User birthday in YYYY-MM-DD format",
            "example": "1980-01-01"
          },
          "anniversary_date": {
            "type": "string",
            "description": "User anniversary in YYYY-MM-DD format",
            "example": "2025-01-01"
          },
          "email": {
            "type": "string",
            "description": "User email address",
            "example": "abdihaikal@email.com"
          },
          "first_name": {
            "type": "string",
            "description": "User first name",
            "example": "Abdi",
            "minLength": 3,
            "maxLength": 50
          },
          "middle_name": {
            "type": "string",
            "description": "User middle name",
            "example": "",
            "minLength": 3,
            "maxLength": 50
          },
          "last_name": {
            "type": "string",
            "description": "User last name",
            "example": "Haikal",
            "minLength": 3,
            "maxLength": 50
          },
          "location": {
            "type": "string",
            "description": "User timezone (IANA Time Zone Database identifier)",
            "example": "Asia/Jakarta",
            "minLength": 5,
            "maxLength": 100,
            "default": "Asia/Jakarta"
          }
        }
      },
      "CreateMessageDto": {
        "type": "object",
        "properties": {
          "user_id": {
            "type": "string",
            "description": "User ID",
            "example": "123e4567-e89b-12d3-a456-4266"
          },
          "type": {
            "type": "string",
            "description": "Message type",
            "example": "regular",
            "default": "regular"
          },
          "subject": {
            "type": "string",
            "description": "Message subject",
            "example": "Regular message"
          },
          "content": {
            "type": "string",
            "description": "Message content",
            "example": "Hi, this is your regular message"
          },
          "schedule_date": {
            "type": "string",
            "description": "Message schedule Date. Format: YYYY-MM-DD",
            "example": "2023-01-01",
            "default": null
          }
        },
        "required": [
          "user_id",
          "subject"
        ]
      },
      "UpdateMessageDto": {
        "type": "object",
        "properties": {
          "user_id": {
            "type": "string",
            "description": "User ID",
            "example": "123e4567-e89b-12d3-a456-4266"
          },
          "type": {
            "type": "string",
            "description": "Message type",
            "example": "regular",
            "default": "regular"
          },
          "subject": {
            "type": "string",
            "description": "Message subject",
            "example": "Regular message"
          },
          "content": {
            "type": "string",
            "description": "Message content",
            "example": "Hi, this is your regular message"
          },
          "schedule_date": {
            "type": "string",
            "description": "Message schedule Date. Format: YYYY-MM-DD",
            "example": "2023-01-01",
            "default": null
          },
          "status": {
            "type": "string",
            "description": "Message status: pending, processing, sent, failed",
            "example": "pending",
            "default": "pending"
          },
          "last_attempt_at": {
            "type": "string",
            "description": "Last attempt at",
            "example": "2023-01-01T00:00:00.000Z"
          },
          "retries_attempted": {
            "type": "number",
            "description": "Retries attempted",
            "example": 0,
            "default": 0
          }
        }
      }
    }
  }
}